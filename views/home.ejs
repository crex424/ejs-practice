<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EJS Practice</title>
</head>
<body>
    <!-- Include partials -->
    <%- include('partials/header') %>

    <% if (person.occupation === 'Plumber') { %>
